<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Hronograf</RootNamespace>
    <AssemblyName>Hronograf</AssemblyName>
    <AssemblyTitle>Хронограф малой родины</AssemblyTitle>
    <Product>Хронограф малой родины</Product>
    <Version>1.0.0</Version>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationIcon></ApplicationIcon>
  </PropertyGroup>

  <!-- Готовая сборка C++ движка (x64) копируется рядом с exe.
       Если вы собрали Engine сами, программа найдёт свежую DLL автоматически. -->
  <ItemGroup>
    <None Include="..\Engine\prebuilt\win-x64\hronograf_engine.dll"
          Condition="Exists('..\Engine\prebuilt\win-x64\hronograf_engine.dll')"
          Link="hronograf_engine.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
